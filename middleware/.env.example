# ================================================================
# .env - Konfigurasi Environment Middleware PACS-SIMGOS
# ================================================================
# SALIN file ini menjadi .env (tanpa .example) dan sesuaikan nilainya.
# File .env TIDAK boleh di-commit ke Git (tambahkan ke .gitignore)

# ─── MLLP Server ─────────────────────────────────────────────────
MLLP_HOST=0.0.0.0
MLLP_PORT=2575

# ─── SIMGOS REST API ─────────────────────────────────────────────
SIMGOS_API_BASE_URL=http://localhost/simgos-api/api/v1
SIMGOS_AUTH_TYPE=api_key
SIMGOS_API_KEY=PACS-BRIDGE-SECRET-KEY-2024
# SIMGOS_API_TOKEN=your-bearer-token-here   # Uncomment jika pakai Bearer

SIMGOS_API_TIMEOUT=15
SIMGOS_API_MAX_RETRIES=3

# ─── Database SIMGOS (untuk PHP) ─────────────────────────────────
SIMGOS_DB_HOST=127.0.0.1
SIMGOS_DB_PORT=3306
SIMGOS_DB_NAME=simgos2
SIMGOS_DB_USER=root
SIMGOS_DB_PASS=

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ─── Info RS ─────────────────────────────────────────────────────
HOSPITAL_NAME=RSUP
