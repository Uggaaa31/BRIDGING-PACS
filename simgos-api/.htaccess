Options -Indexes

# Aktifkan mod_rewrite
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route: PUT /api/v1/radiologi/pacs-bridging/{identifier} (mendukung root maupun /simgos-api/)
RewriteRule ^(?:simgos-api/)?api/v1/radiologi/pacs-bridging/(.+)$ api/pacs_bridging.php [QSA,L]

# Keamanan: Blokir akses langsung ke config dan model
RewriteRule ^(?:simgos-api/)?(config|models)/.*$ - [F,L]

# Keamanan: blokir akses HTTP ke direktori log (berisi data pasien)
RewriteRule ^(?:simgos-api/)?logs(/|$) - [F,L]

# Lapisan kedua: tolak unduhan file .log di mana pun dalam webroot
<IfModule mod_authz_core.c>
    <FilesMatch "\.log$">
        Require all denied
    </FilesMatch>
</IfModule>

# Header keamanan
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
