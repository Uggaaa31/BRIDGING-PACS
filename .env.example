# ==============================================================================
# ENVIRONMENT PRODUCTION - BRIDGING PACS-SIMGOS (DOCKER & STANDALONE)
# ==============================================================================
# Salin file ini menjadi .env di root project:
#   copy .env.example .env
#
# File .env TIDAK boleh di-commit ke Git karena berisi kredensial sensitif.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PENGATURAN MLLP LISTENER (Koneksi dari Alat / Komputer PACS)
# ------------------------------------------------------------------------------
# Port MLLP yang dibuka ke jaringan RS untuk menerima pesan HL7 (default: 2575)
MLLP_PORT=2575
MLLP_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. PENGATURAN DATABASE SIMGOS (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# - Jika menggunakan Docker di PC/laptop (akses MySQL lokal host): host.docker.internal
# - Jika di server produksi RS: masukkan IP server DB sebenarnya (contoh: 10.10.160.99)
# - Jika mode standalone (tanpa Docker): 127.0.0.1
SIMGOS_DB_HOST=
SIMGOS_DB_PORT=
SIMGOS_DB_NAME=
SIMGOS_DB_USER=root
SIMGOS_DB_PASS=

# ------------------------------------------------------------------------------
# 3. PENGATURAN REST API & KEAMANAN SIMGOS
# ------------------------------------------------------------------------------
# Port HTTP untuk SIMGOS API saat diakses dari host Docker (default: 8080)
SIMGOS_API_HOST_PORT=8080

# URL endpoint SIMGOS API:
# - Untuk mode Docker (antar-kontainer): http://simgos-api/api/v1
# - Untuk mode Standalone / Laragon: http://localhost/simgos-api/api/v1
SIMGOS_API_BASE_URL=

# Tipe Autentikasi: "api_key" atau "bearer"
SIMGOS_AUTH_TYPE=api_key
SIMGOS_API_KEY=
# SIMGOS_API_TOKEN=your-bearer-token-here   # Aktifkan jika SIMGOS_AUTH_TYPE=bearer

SIMGOS_API_TIMEOUT=15
SIMGOS_API_MAX_RETRIES=3

# Lokasi file log API. Di Docker: /var/log/simgos/simgos_api.log (luar webroot).
# Kosongkan untuk default (simgos-api/logs/simgos_api.log, diblokir dari HTTP).
SIMGOS_API_LOG_FILE=

# ------------------------------------------------------------------------------
# 4. PENGATURAN LOGGING & IDENTITAS RS
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
HOSPITAL_NAME=RSUP
