# ==============================================================================
# ENVIRONMENT PRODUCTION - BRIDGING PACS-SIMGOS (DOCKER)
# ==============================================================================
# Salin file ini menjadi .env:
#   copy .env.example .env
#
# File .env TIDAK boleh di-commit ke Git karena berisi kredensial sensitif.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PENGATURAN MLLP LISTENER (Koneksi dari Alat / Komputer PACS)
# ------------------------------------------------------------------------------
# Port MLLP yang dibuka ke jaringan RS (default: 2575)
MLLP_PORT=2575
MLLP_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. PENGATURAN DATABASE SIMGOS (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Jika database berada di server RS lain (misal: 10.10.160.99), masukkan IP tersebut.
# Jika database diuji coba di komputer lokal (Laragon/MySQL host), gunakan: host.docker.internal
SIMGOS_DB_HOST=10.10.160.99
SIMGOS_DB_PORT=3306
SIMGOS_DB_NAME=simgos2
SIMGOS_DB_USER=root
SIMGOS_DB_PASS=

# ------------------------------------------------------------------------------
# 3. PENGATURAN REST API & KEAMANAN
# ------------------------------------------------------------------------------
# Port HTTP untuk SIMGOS API jika ingin diakses dari host (default: 8080)
SIMGOS_API_HOST_PORT=8080

# URL endpoint internal antar-kontainer Docker
SIMGOS_API_BASE_URL=http://simgos-api/api/v1

# Autentikasi API Key
SIMGOS_AUTH_TYPE=api_key
SIMGOS_API_KEY=PACS-BRIDGE-SECRET-KEY-2024
SIMGOS_API_TIMEOUT=15
SIMGOS_API_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 4. PENGATURAN LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
